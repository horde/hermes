// ----------------------------------------------------------------------
// Time Tracking Settings
// ----------------------------------------------------------------------
// Should users enter whether time is billable or not billable?
$conf['time']['choose_ifbillable'] = true;
// How many days should we keep time after it is exported/billed?
$conf['time']['days_to_keep'] = 60;
// Enable deliverables as cost objects?
$conf['time']['deliverables'] = false;
// Only include billable times when calculating time sums?
$conf['time']['sum_billable_only'] = false;

// ----------------------------------------------------------------------
// Storage System Settings
// ----------------------------------------------------------------------
// What storage driver should we use? ('sql')
$conf['storage']['driver'] = 'sql';
