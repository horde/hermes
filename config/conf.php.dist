// $conf['storage']['params']['ssl'] = false;
$conf['storage']['params']['driverconfig'] = 'horde';

// ----------------------------------------------------------------------
// Clients
// ----------------------------------------------------------------------
// Field name from the client address book to display in the client list
$conf['client']['field'] = 'name';

// ----------------------------------------------------------------------
// Invoices
